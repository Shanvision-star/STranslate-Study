<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>ChefKeys</id>
    <version>0.1.2</version>
    <authors>Jeremy Wu</authors>
    <license type="expression">Apache-2.0</license>
    <licenseUrl>https://licenses.nuget.org/Apache-2.0</licenseUrl>
    <projectUrl>https://github.com/jjw24/ChefKeys</projectUrl>
    <description>Library for applications to use the Win key or any keyboard combinations</description>
    <copyright>Jeremy Wu</copyright>
    <tags>chefkeys win-key hotkeys keyboard-hotkeys keyboard-combinations</tags>
    <repository url="https://github.com/jjw24/ChefKeys" />
    <dependencies>
      <group targetFramework="net7.0-windows7.0" />
    </dependencies>
    <frameworkReferences>
      <group targetFramework="net7.0-windows7.0">
        <frameworkReference name="Microsoft.WindowsDesktop.App.WPF" />
      </group>
    </frameworkReferences>
  </metadata>
</package>